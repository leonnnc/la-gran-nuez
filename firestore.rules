rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'leonnnc@gmail.com';
    }

    // Configuración pública (lectura) y editable solo por el administrador.
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Catálogo público (lectura) y editable solo por el administrador.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pedidos: los clientes pueden crear; solo el administrador puede leer/gestionar.
    match /orders/{orderId} {
      allow create: if request.resource.data.code is string
        && request.resource.data.customer.name is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
